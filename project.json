{
  "name": "Murmur",
  "options": {
    "deploymentTarget": {
      "iOS": "16.0"
    }
  },
  "settings": {
    "base": {
      "SWIFT_VERSION": "5.0",
      "TARGETED_DEVICE_FAMILY": "1,2",
      "MARKETING_VERSION": "0.2.0",
      "CURRENT_PROJECT_VERSION": "2",
      "CODE_SIGN_STYLE": "Automatic",
      "GENERATE_INFOPLIST_FILE": false
    }
  },
  "targets": {
    "Murmur": {
      "type": "application",
      "platform": "iOS",
      "sources": [
        "App",
        "Shared"
      ],
      "settings": {
        "base": {
          "PRODUCT_BUNDLE_IDENTIFIER": "com.vijitpugalia.murmur.ios",
          "PRODUCT_NAME": "Murmur",
          "INFOPLIST_FILE": "Config/App.plist",
          "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
          "CODE_SIGN_ENTITLEMENTS": "Config/Shared.entitlements"
        }
      },
      "dependencies": [
        {
          "target": "MurmurKeyboard",
          "embed": true
        }
      ]
    },
    "MurmurKeyboard": {
      "type": "app-extension",
      "platform": "iOS",
      "sources": [
        "Keyboard",
        "Shared"
      ],
      "settings": {
        "base": {
          "PRODUCT_BUNDLE_IDENTIFIER": "com.vijitpugalia.murmur.ios.keyboard",
          "INFOPLIST_FILE": "Config/Keyboard.plist",
          "CODE_SIGN_ENTITLEMENTS": "Config/Shared.entitlements",
          "APPLICATION_EXTENSION_API_ONLY": true,
          "SKIP_INSTALL": true
        }
      }
    }
  },
  "schemes": {
    "Murmur": {
      "build": {
        "targets": {
          "Murmur": "all"
        }
      }
    }
  }
}
